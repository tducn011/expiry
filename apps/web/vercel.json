{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://homeserver.tailc535bb.ts.net/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://homeserver.tailc535bb.ts.net/api/$1"
    },
    {
      "source": "/scan/(.*)",
      "destination": "https://homeserver.tailc535bb.ts.net/scan/$1"
    },
    {
      "source": "/scan",
      "destination": "https://homeserver.tailc535bb.ts.net/scan"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

