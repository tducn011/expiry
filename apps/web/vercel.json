{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://bathrooms-boost-breaking-atlas.trycloudflare.com/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://bathrooms-boost-breaking-atlas.trycloudflare.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

