{
  "name": "expiry-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:web": "npm --workspace=apps/web run build",
    "test:api": "npm --workspace=apps/api test",
    "test:python": "docker run --rm -v ./services/python-scan:/app expiry-python-scan python -m unittest discover tests",
    "test:ui": "pnpm --filter expiry-ui test",
    "test:dbops": "node scripts/test-dbops.mjs",
    "test:format": "cd apps/web && ./node_modules/.bin/oxfmt --check src/",
    "format": "cd apps/web && ./node_modules/.bin/oxfmt src/",
    "typecheck": "npm --workspace=apps/web run typecheck",
    "test:behavior": "node scripts/test-behavior-contract.mjs",
    "test:all": "npm run test:api && npm run test:python && npm run test:ui && npm run test:dbops && npm run build:web && npm run test:behavior",
    "review:pr": "node scripts/review-pr.mjs",
    "notify": "node scripts/notify-mobile.mjs",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "db:migrate": "node database/mysql/scripts/manage.mjs migrate-dev"
  }
}
