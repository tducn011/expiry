#!/usr/bin/env python3
"""Focused stdlib regression checks for local retrieval; never mutates source."""
import json
import subprocess
from unittest.mock import patch

import context
import knowledge

results = []
for query, prefix, expected in [
    ('attention timezone', 'apps/api/src', 'apps/api/src/shared/'),
    ('UC-07', 'docs/architecture/04-user-flows', 'docs/architecture/04-user-flows/'),
    ('parent navigation', '.tmb/tasks/CAP-03', '.tmb/tasks/CAP-03/'),
]:
    response = knowledge.search(query, 6, prefix)
    assert response['results'] and any(row['path'].startswith(expected) for row in response['results'])
    assert all(row['path'].startswith(prefix) for row in response['results'])
    assert all(row['sha256'] and row['citation'] and row['heading'] for row in response['results'])
    results.append({'query': query, 'status': 'PASS', 'matching': response['matching'], 'results': response['results']})

with patch.object(context, 'digest', return_value='changed-source-hash'):
    try:
        knowledge.search('attention', 2, '')
    except ValueError as error:
        assert str(error).startswith('Stale index;')
        results.append({'check': 'stale source refusal', 'status': 'PASS'})
    else:
        raise AssertionError('Search accepted stale hashes')
assert knowledge.search('attention', 2, 'docs%')['results'] == []
try:
    knowledge.search('???', 2, '')
except ValueError:
    results.append({'check': 'empty terms and literal prefix guards', 'status': 'PASS'})
else:
    raise AssertionError('Punctuation-only query accepted')

context.save_json(context.TMB / 'evidence/retrieval-tests.json', {'status': 'PASS', 'checks': results,
                  'limits': 'Local lexical retrieval guards/citations, not semantic RAG quality or all corpus authority.'})
for name, command, cwd in [
    ('web-build-extension', ['npm', 'run', 'build:web'], context.ROOT),
    ('web-typecheck-extension', ['pnpm', 'exec', 'tsc', '--noEmit'], context.ROOT / 'apps/web'),
    ('web-format-extension', ['pnpm', 'exec', 'oxfmt', '--check', 'src/components/layout/Breadcrumb.tsx',
                             'src/features/Detail.tsx', 'src/App.tsx', 'src/demo/DemoApp.tsx'], context.ROOT / 'apps/web'),
]:
    run = subprocess.run(command, cwd=cwd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    (context.TMB / f'evidence/{name}.txt').write_text(run.stdout)
    results.append({'check': name, 'command': command, 'cwd': str(cwd), 'exit_code': run.returncode})
context.save_json(context.TMB / 'evidence/extension-checks.json', {'results': results[-3:]})
print(json.dumps({'retrieval': 'PASS', 'commands': results[-3:]}, indent=2))
