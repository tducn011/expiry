import argparse
import hashlib
import json
import os
import re
import sqlite3
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote

import context

ROOT, TMB = context.ROOT, context.TMB
INDEX = TMB / 'context/retrieval.sqlite'
MARKER = context.MARKER
LINK = re.compile(r'!?\[[^\]\n]*\]\(([^)\n]+)\)')
ALIASES = {'docs': 'docs', 'apps': 'app', 'apps/web': 'web', 'apps/api': 'api',
           'database/mysql': 'database', 'services/python-scan': 'scan'}


def now():
    return datetime.now(timezone.utc).isoformat()


def tasks():
    return json.loads((TMB / 'tasks/tasks.json').read_text())


def link_to(path, owner):
    return Path(os.path.relpath(ROOT / path, owner.parent)).as_posix()


def status(text):
    match = re.search(r'^- Status:\s*(.+)$', text, re.M)
    return match.group(1).replace('**', '') if match else 'not declared'


def catalog():
    documents = sorted(p for p in (ROOT / 'docs').rglob('*') if p.is_file() and not p.is_symlink()
                       and p.suffix in {'.md', '.txt', '.puml', '.mmd', '.json', '.csv'})
    entries, broken, groups = [], [], {}
    for path in documents:
        relative = path.relative_to(ROOT).as_posix()
        text = path.read_text(errors='replace')
        section = path.parent.relative_to(ROOT / 'docs').as_posix()
        historical = '/consolidated/' in relative or '/erd-workbench/' in relative
        classification = ('HISTORICAL_OK' if historical else 'TEMPLATE_OR_EXAMPLE'
                          if '/12-process/' in relative else 'GENERATED_NOT_SOT'
                          if '/tooling/' in relative else 'UNKNOWN_REVIEW_REQUIRED')
        # ponytail: metadata triage, not a fabricated semantic review of the whole corpus.
        entry = {'path': relative, 'sha256': context.digest(path), 'lines': len(text.splitlines()),
                 'title': next((line.lstrip('# ').strip() for line in text.splitlines()
                                if line.startswith('# ')), path.name),
                 'declared_status': status(text), 'classification': classification}
        for number, line in enumerate(text.splitlines(), 1):
            for target in LINK.findall(line):
                target = target.strip().strip('<>')
                if re.match(r'^[a-z]+:', target) or target.startswith('#'):
                    continue
                local = unquote(target.split('#', 1)[0].split('?', 1)[0])
                if local and not (path.parent / local).exists():
                    broken.append({'source': relative, 'line': number, 'target': target,
                                   'status': 'historical-reference' if historical else 'needs-source-review'})
        entries.append(entry)
        groups.setdefault(section, []).append(entry)
    context.save_json(TMB / 'evidence/docs-catalog.json', {'captured_at': now(), 'documents': entries,
                      'limits': 'Metadata only. Source labels retained; semantic authority is not inferred.'})
    context.save_json(TMB / 'evidence/docs-link-audit.json', {'captured_at': now(),
                      'status': 'NEEDS_REPAIR' if broken else 'PASS', 'broken_count': len(broken),
                      'broken': broken, 'limits': 'Local target existence only; URL/anchor meaning not checked.'})
    output = TMB / 'layouts/docs/CATALOG.md'
    rows = [MARKER, '# Documentation catalog and per-folder layouts', '',
            'Generated metadata; read original source before accepting a rule or approval.', '',
            f'{len(entries)} text artifacts; {len(broken)} missing local link targets. '
            'This is not a clean-vault claim.', '',
            '| Folder | Detail layout | Files |', '| :--- | :--- | ---: |']
    for group, values in sorted(groups.items()):
        owner = TMB / 'layouts/docs/sections' / group / 'LAYOUT.md'
        owner.parent.mkdir(parents=True, exist_ok=True)
        detail = [MARKER, f'# docs/{group} — detailed artifact layout', '',
                  'One row per text artifact. Metadata classification is provisional; '
                  'declared source status is not implementation verification.', '',
                  '| Source | Purpose/title | Declared status | Triage class |',
                  '| :--- | :--- | :--- | :--- |']
        for item in values:
            title = item['title'].replace('|', '\\|')
            detail.append(f"| [{Path(item['path']).name}]({link_to(item['path'], owner)}) | "
                          f"{title} | {item['declared_status']} | {item['classification']} |")
        owner.write_text('\n'.join(detail) + '\n')
        rows.append(f'| docs/{group} | [LAYOUT]({os.path.relpath(owner, output.parent)}) | {len(values)} |')
    output.write_text('\n'.join(rows) + '\n')
    print(json.dumps({'documents': len(entries), 'folder_layouts': len(groups), 'broken_links': len(broken)}))


def specs():
