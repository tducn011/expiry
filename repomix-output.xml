    expected_progress = '\n'.join(module.render(module.phases(roadmap_text))).strip()
    report(actual_progress == expected_progress, 'generated progress is stale; run refresh')
    for phase in phases():
        report(0 < len(phase['tasks']) <= 12, f"{phase['title']}: tasks must be1..12")
        report(any(task['section'] == 'Exit criteria' for task in phase['tasks']), f"{phase['title']}: no exit criteria")
        for task in phase['tasks']:
