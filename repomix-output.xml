export async function verifyPassword(password, verifier) {
  validatePassword(password);
  const stored = verifier ?? dummyVerifier;
  const match = /^scrypt\$131072\$8\$1\$([0-9a-f]{32})\$([0-9a-f]{128})$/.exec(stored);
