#!/usr/bin/env python3
"""Local TMB context/navigation adapter; no application or database writes.

Inventory is static evidence. Refresh derives status/context from root ROADMAP.
Audit rejects stale source hashes, missing map links or incomplete task evidence.
Extension engines referenced by hackathon's Gemini skills are absent; this helper
implements their bounded snapshot/audit role while retaining canonical progress.
"""
import argparse
import ast
import hashlib
import importlib.util
import json
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TMB = ROOT / '.tmb'
UPSTREAM = Path('/home/pro/Downloads/hackathon')
MARKER = '<!-- trustmebro -->'
SUBSYSTEMS = ('docs', 'app', 'web', 'api', 'database', 'scan', 'contracts', 'delivery')
EXTENSIONS = {'.ts', '.tsx', '.mjs', '.py', '.sql', '.json', '.yaml', '.yml', '.md', '.txt', '.css', '.puml', '.mmd'}
IMPORT = re.compile(r'(?:import\s+(?:[\s\S]*?\s+from\s+)?|export\s+(?:type\s+)?\{[^}]*\}\s+from\s+)["\']([^"\']+)["\']')
TASK = re.compile(r'^\s*[-*] \[([ xX~])\] (\S+) (.*)$')


def git(*args):
    return subprocess.check_output(['git', *args], cwd=ROOT, text=True).strip()


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')


def local_import(path, specifier):
    if not specifier.startswith(('.', '@/')):
        return None
    base = ROOT / 'apps/web/src' / specifier[2:] if specifier.startswith('@/') else path.parent / specifier
    candidates = [base] + [Path(str(base) + ext) for ext in ('.tsx', '.ts', '.mjs', '.js', '.css')]
    candidates += [base / ('index' + ext) for ext in ('.tsx', '.ts', '.mjs', '.js')]
    for candidate in candidates:
        if candidate.is_file() and candidate.resolve().is_relative_to(ROOT):
            return candidate.resolve().relative_to(ROOT).as_posix()
    return None


def phases():
    result, current, section = [], None, ''
    for line in (ROOT / 'ROADMAP.md').read_text().splitlines():
        if line.startswith('## '):
            title = line[3:]
            current = {'title': title, 'tasks': []} if ':' in title else None
            if current:
                result.append(current)
            section = ''
        elif line.startswith('### '):
            section = line[4:]
        elif current and (match := TASK.match(line)):
            state, task_id, description = match.groups()
            current['tasks'].append({'state': state.lower(), 'id': task_id,
                                     'description': description, 'section': section})
    return result


def progress_module():
    script = UPSTREAM / 'src/scripts/roadmap_progress.py'
    spec = importlib.util.spec_from_file_location('tmb_progress', script)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def progress():
    module = progress_module()
    module.main(str(ROOT / 'ROADMAP.md'))
    for name in SUBSYSTEMS:
        board = TMB / f'layouts/{name}/ROADMAP.md'
        layout = TMB / f'layouts/{name}/LAYOUT.md'
        if not layout.exists():
            continue
        # Per-subsystem boards are views of root status, never separate checkboxes.
        relevant = {
            'web': {'F-00', 'F-01', 'F-02', 'F-03', 'F-04'},
            'api': {'F-01', 'F-02', 'F-05', 'F-06'},
            'database': {'F-05', 'F-06'}, 'scan': {'F-02', 'F-06'},
            'contracts': {'F-01', 'F-02', 'F-06'}, 'delivery': {'F-00', 'F-01', 'F-06'},
            'docs': {'DOC-01'}, 'app': {'F-00', 'F-01', 'F-02', 'F-03', 'F-04', 'F-05', 'F-06'},
        }[name]
        rows = [MARKER, f'# {name} roadmap (generated root-status view)', '',
                'Status owner: `ROADMAP.md` in the repository root. Edit tasks there,',
                'then run `python3 .tmb/tools/context.py refresh`. This view grants no',
                'implementation permission. Map owner: `.tmb/layouts/' + name + '/LAYOUT.md`.', '',
                '| Task | State | Root phase | Work |', '| :--- | :--- | :--- | :--- |']
        for phase in phases():
            for task in phase['tasks']:
                if task['id'].startswith(('MAP-', 'GATE-', 'CTX-', 'CAP-')) or task['id'] in relevant or (name in {'web', 'app'} and task['id'].startswith(('NAV-', 'RSP-'))):
                    state = {'x': 'verified', '~': 'unverified', ' ': 'open'}[task['state']]
                    description = task['description'].replace('|', '\\|')
                    rows.append(f"| {task['id']} | {state} | {phase['title']} | {description} |")
        board.write_text('\n'.join(rows) + '\n')


def snapshot():
    phase_list = phases()
    # Authorized extension work precedes the separate, unselected product backlog.
    phase_list.sort(key=lambda p: not any(t['id'].startswith(('CTX-', 'NAV-', 'RSP-')) and t['state'] != 'x' for t in p['tasks']))
    active = next((phase for phase in phase_list
                   if any(task['state'] != 'x' for task in phase['tasks'])), None)
    if active:
        done = sum(task['state'] == 'x' for task in active['tasks'])
        open_tasks = [task['id'] for task in active['tasks'] if task['state'] != 'x']
        manifest = TMB / 'tasks/tasks.json'
        if manifest.exists():
            dependencies = {task['id']: task['depends'] for task in json.loads(manifest.read_text())}
            states = {task['id']: task['state'] for phase in phase_list for task in phase['tasks']}
            ready = [task for task in open_tasks if not task.startswith('GATE-')
                     and all(states.get(dep) == 'x' for dep in dependencies.get(task, []))]
            open_tasks = ready or open_tasks
        text = (f"# {active['title']}\n{done}/{len(active['tasks'])} verified.\n"
                f"Next: {', '.join(open_tasks[:3])}\n"
                "Read: .tmb/tasks/README.md\nStatus: ROADMAP.md\n")
    else:
        text = '# Mapping complete\nRead LAYOUT.md and .tmb/maps/feature-impact.md for the next authorized task.\n'
    # ASCII-only snapshot with a conservative byte upper bound, not guessed token savings.
    if len(text.encode()) > 200:
        raise ValueError('Navigator snapshot exceeds 200 UTF-8 bytes')
    target = TMB / 'context/current-phase.md'
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text)
    print(f'Navigator: {len(text.encode())} bytes (conservative <=200-byte token bound)')


def inventory():
    files = git('ls-files').splitlines()
    scope_file = TMB / 'evidence/scope.json'
    if scope_file.exists():
        files += [p for p in json.loads(scope_file.read_text())['allowed_new_sources']
                  if p not in files and (ROOT / p).is_file()]
    sources, graph, routes, tables = [], {}, [], []
    for relative in files:
        path = ROOT / relative
        if not path.is_file() or not (path.suffix in EXTENSIONS or path.name in {'.gitignore', 'Dockerfile'}):
            continue
        if not (relative.startswith(('apps/', 'services/', 'database/mysql/', 'contracts/', 'docs/architecture/'))
                or relative in {'.gitignore', 'package.json', 'compose.yaml', 'README.md', 'vercel.json'}):
            continue
        if '/evidence/' in relative or '/.tools/' in relative:
            continue
        text = path.read_text(errors='replace')
        imports = []
        if path.suffix in {'.ts', '.tsx', '.mjs'}:
            for specifier in IMPORT.findall(text):
                imports.append({'specifier': specifier, 'target': local_import(path, specifier)})
        graph[relative] = sorted({item['target'] for item in imports if item['target']})
        source = {'path': relative, 'sha256': digest(path), 'lines': len(text.splitlines()),
                  'imports': imports}
        if path.suffix == '.py':
            tree = ast.parse(text)
            source['symbols'] = [node.name for node in ast.walk(tree)
                                 if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))]
        else:
            source['symbols'] = re.findall(r'\b(?:function|class)\s+(\w+)', text)
        sources.append(source)
        if relative.endswith('.routes.mjs') or relative == 'apps/api/src/app.mjs':
            base = '/api/v1/auth' if '/auth/' in relative else '/api/v1'
            for method, route, handler in re.findall(r"(?:router|app)\.(get|post|patch|delete)\('([^']+)',\s*([^\n]+)", text):
                routes.append({'stack': 'node', 'method': method.upper(),
                               'path': route if relative.endswith('/app.mjs') else base + route,
