    report(len((TMB / 'context/architecture.md').read_bytes()) <= 650, 'architecture anchor byte budget exceeded')
    result = {'status': 'FAIL' if failures else 'PASS', 'checks': 'markers, canonical progress, eight maps/boards, phases/exits/evidence, paths, source freshness, routes/tables/UI coverage, ignore, scoped tracked diff, context budgets', 'failures': failures}
    save_json(TMB / 'evidence/context-audit.json', result)
    print(json.dumps(result, indent=2))
    if failures:
        raise SystemExit(1)


def impact(path):
    data = json.loads((TMB / 'evidence/source-inventory.json').read_text())
