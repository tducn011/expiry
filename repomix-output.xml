    ),
    "calendar-x": (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 11h18m7 4 4 4m0-4-4 4" />
      </>
    ),
    bottle: (
      <>
        <path d="M10 2h4v5l3 3v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V10l3-3V2ZM10 5h4M7 13h10" />
