               f"unmapped route: {route['method']} {route['path']}")
    for table in saved['migration_tables']:
        report(f"| {table['name']} |" in database_map, f"unmapped table: {table['name']}")
    for feature in (ROOT / 'apps/web/src/features').glob('*.tsx'):
        report(str(feature.relative_to(ROOT)) in web_map, f'unmapped UI feature: {feature.name}')
    view_source = (ROOT / 'apps/web/src/components/layout/Shell.tsx').read_text()
    action_source = (ROOT / 'apps/web/src/features/Detail.tsx').read_text()
    for source, name in ((view_source, 'View'), (action_source, 'DetailAction')):
        declaration = re.search(rf'export type {name} = ([^\n]+)', source).group(1)
        for value in re.findall(r'"([^"]+)"', declaration):
            report(value in nav_map, f'unmapped {name}: {value}')
    for source in saved['source_files']:
        path = ROOT / source['path']
        report(path.exists() and digest(path) == source['sha256'], f"source drift: {source['path']}")
    outputs = ['AGENTS.md', 'LAYOUT.md', 'PLAN.md', 'ROADMAP.md'] + [str(p.relative_to(ROOT)) for p in TMB.rglob('*') if p.is_file()]
    ignored = subprocess.run(['git', 'check-ignore', '--stdin'], input='\n'.join(outputs) + '\n', cwd=ROOT, text=True, capture_output=True)
    report(set(outputs) <= set(ignored.stdout.splitlines()), 'not all outputs ignored')
    scope_file = TMB / 'evidence/scope.json'
    allowed = set(json.loads(scope_file.read_text())['allowed_tracked_changes']) if scope_file.exists() else {'.gitignore'}
    report(set(git('diff', '--name-only').splitlines()) <= allowed, 'unexpected tracked source changes')
    snapshot_path = TMB / 'context/current-phase.md'
