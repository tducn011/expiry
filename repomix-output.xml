      "post": {
        "operationId": "API-13",
        "summary": "API-13 POST /scans - Upload food image for OCR and candidate extraction",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Food package image file (max 5MB, JPEG/PNG/WebP)"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "image_base64"
                ],
                "additionalProperties": false,
                "properties": {
                  "image_base64": {
                    "type": "string",
                    "description": "Base64 JPEG/PNG/WebP bytes, decoded size at most5MiB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction result with candidate fields for user review and edit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "raw_text",
                    "candidates",
                    "requires_confirmation"
                  ],
                  "properties": {
                    "raw_text": {
                      "type": "string"
                    },
                    "candidates": {
                      "type": "object",
                      "properties": {
                        "food_name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "expiry_date": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "date"
                            },
                            "date_certainty": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "enum": [
                                "exact",
                                "inferred",
                                null
                              ]
                            },
                            "date_label_type": {
                              "type": "string"
                            },
                            "source_text": {
                              "type": "string"
                            },
                            "alternatives": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "format": "date"
                              }
                            },
                            "ambiguous": {
                              "type": "boolean"
                            },
                            "requires_confirmation": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "requires_confirmation": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed image upload"
