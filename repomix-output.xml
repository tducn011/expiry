            <div className="form-grid">
              <Field
                label="Nhắc trước (ngày)"
                error={error}
                hint="Báo trước bao nhiêu ngày khi món sắp hết"
              >
                <input
                  type="number"
                  inputMode="numeric"
                  min="0"
