<file path="apps/web/src/hooks/useExpiry.ts">
import { useCallback, useEffect, useMemo, useRef, useState } from "react"
import { ApiClient, ApiError, type Command, type Page } from "../api/client"
import type { FoodEntry, Preferences, QuantityMovement, Session } from "../domain/types"
import type { InventoryFilters } from "../features/Inventory"

const emptyPage: Page<FoodEntry> = { items: [], pagination: { page: 1, limit: 20, total: 0 } }
const attentionQuery = { past: "past_date", today: "due_today", soon: "soon", unknown: "unknown", later: "later", all: "" }

/** Owner changes invalidate data and in-flight responses. Drafts remain App-owned. */
export function useExpiry(view: string, filters: InventoryFilters, page: number) {
  const api = useMemo(() => new ApiClient(), [])
  const [session, setSession] = useState<Session | null>(null)
  const sessionRef = useRef<Session | null>(null)
  const lastOwner = useRef<string | null>(null)
  const epoch = useRef(0)
  const [checking, setChecking] = useState(true)
  const [loading, setLoading] = useState(false)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState<ApiError | null>(null)
  const [revision, setRevision] = useState(0)
  const [allFoods, setAllFoods] = useState<FoodEntry[]>([])
  const [list, setList] = useState<Page<FoodEntry>>(emptyPage)
  const [trash, setTrash] = useState<FoodEntry[]>([])
  const [prefs, setPrefs] = useState<Preferences | null>(null)
  const [asOfDate, setAsOfDate] = useState("")
  const [selectedId, setSelectedId] = useState<string | null>(null)
  const [selected, setSelected] = useState<FoodEntry | null>(null)
  const [history, setHistory] = useState<QuantityMovement[]>([])
  const pending = useRef<Command | null>(null)
  const [canRetry, setCanRetry] = useState(false)

  const clearData = useCallback(() => {
    setAllFoods([]); setList(emptyPage); setTrash([]); setPrefs(null); setSelected(null); setHistory([]); setAsOfDate("")
  }, [])
  const fail = useCallback((failure: unknown) => {
    const problem = failure instanceof ApiError ? failure : new ApiError(0, "NETWORK_ERROR", true)
    setError(problem)
    if (problem.status === 401 || problem.status === 403) {
      epoch.current++
      sessionRef.current = null
      setSession(null)
      clearData()
    }
    return problem
  }, [clearData])
  const acceptSession = useCallback((value: Session) => {
    const changed = lastOwner.current !== null && lastOwner.current !== value.user.id
    epoch.current++
    clearData()
    if (changed) { pending.current = null; setCanRetry(false); setSelectedId(null) }
    lastOwner.current = value.user.id
    sessionRef.current = value
    setSession(value); setError(null)
    return changed
  }, [clearData])

  useEffect(() => {
    let active = true
    api.session().then(value => { if (active) acceptSession(value) }).catch(error => {
      if (active && !(error instanceof ApiError && error.status === 401)) fail(error)
    }).finally(() => { if (active) setChecking(false) })
    return () => { active = false }
  }, [api, acceptSession, fail])

  const query = useMemo(() => {
    const values: Record<string, string | number> = { page, limit: 20, view: view === "attention" ? "attention" : "inventory", lifecycle: view === "attention" ? "active" : filters.lifecycle === "Đã hết" ? "depleted" : filters.lifecycle === "Tất cả" ? "all" : "active" }
    if (filters.query) values.q = filters.query
    if (filters.location !== "Tất cả vị trí") values.location = filters.location
    if (attentionQuery[filters.attentionFilter]) values.attention = attentionQuery[filters.attentionFilter]
    return values
  }, [page, view, filters.query, filters.location, filters.lifecycle, filters.attentionFilter])

  useEffect(() => {
    if (!session) return
    let active = true
    const ownerEpoch = epoch.current
    setLoading(true)
    Promise.all([api.allEntries(), api.entries(query), api.preferences(), view === "trash" ? api.allEntries(true) : Promise.resolve({ items: [] as FoodEntry[] })]).then(([summary, entries, preferences, deleted]) => {
      if (!active || ownerEpoch !== epoch.current) return
      setAllFoods(summary.items); setList(entries); setPrefs(preferences); setTrash(deleted.items)
      setAsOfDate(entries.as_of_date || summary.as_of_date || "")
    }).catch(error => { if (active && ownerEpoch === epoch.current) fail(error) }).finally(() => { if (active) setLoading(false) })
    return () => { active = false }
  }, [api, session, query, view, revision, fail])

  useEffect(() => {
    setSelected(null); setHistory([])
    if (!selectedId || !session) return
    let active = true
    const ownerEpoch = epoch.current
    Promise.all([api.entry(selectedId), api.history(selectedId)]).then(([entry, movements]) => {
      if (active && ownerEpoch === epoch.current) { setSelected(entry); setHistory(movements) }
    }).catch(error => { if (active && ownerEpoch === epoch.current) fail(error) })
    return () => { active = false }
  }, [api, selectedId, session, revision, fail])

  const authenticate = async (mode: "login" | "register", input: { email: string; password: string; display_name?: string }) => {
    setBusy(true)
    try { return { ok: true, changed: acceptSession(await api.authenticate(mode, input)) } }
    catch (error) { fail(error); return { ok: false, changed: false } }
    finally { setBusy(false) }
  }
  const logout = async () => {
    setBusy(true)
    try { await api.logout() }
    catch (error) { fail(error); if (!(error instanceof ApiError && error.status === 401)) return false }
    finally { setBusy(false) }
    epoch.current++; sessionRef.current = null; lastOwner.current = null; pending.current = null
    setSession(null); setSelectedId(null); setCanRetry(false); setError(null); clearData()
    return true
  }
  const run = async (command: Command) => {
    const owner = sessionRef.current?.user.id
    if (!owner || owner !== command.owner) { fail(new ApiError(401, "AUTH_REQUIRED")); return { ok: false } }
    if (pending.current && pending.current !== command) { fail(new ApiError(409, "COMMAND_PENDING")); return { ok: false } }
    pending.current = command
    const ownerEpoch = epoch.current
    setBusy(true); setError(null); setCanRetry(false)
    try {
      const body = await api.execute<unknown>(command)
      if (ownerEpoch !== epoch.current || sessionRef.current?.user.id !== command.owner) return { ok: false }
      pending.current = null; setCanRetry(false); setRevision(value => value + 1)
      return { ok: true, body }
    } catch (error) {
      if (ownerEpoch !== epoch.current) return { ok: false }
      const problem = fail(error)
      if (problem.uncertain || problem.status === 401 || problem.status === 403) setCanRetry(true)
      else { pending.current = null; setCanRetry(false); setRevision(value => value + 1) }
      return { ok: false }
    } finally { setBusy(false) }
  }
  const retry = () => pending.current ? run(pending.current) : Promise.resolve({ ok: false })
  const refresh = () => { setError(null); setRevision(value => value + 1) }
  return { api, session, checking, loading, busy, error, setError, authenticate, logout, run, retry, canRetry, refresh, allFoods, list, trash, prefs, asOfDate, selectedId, setSelectedId, selected, history }
}
</file>

<file path="apps/web/src/App.tsx">
import { useMemo, useState } from "react"
import { attentionFor, mockApi } from "./mockApi"
import type {
  Attention,
  CreatePayload,
  EntryDraft,
  FoodEntry,
} from "./domain/types"
import Shell, { View } from "./components/layout/Shell"
import Icon from "./components/ui/Icon"
import Detail, { DetailAction } from "./features/Detail"
import EntryForm from "./features/EntryForm"
import History from "./features/History"
import Inventory, {
  defaultFilters,
  InventoryFilters,
} from "./features/Inventory"
import MovementForm, { MovementMode } from "./features/MovementForm"
import Settings from "./features/Settings"
import StatusDialog, { Dialog, StatusMode } from "./features/StatusDialog"
import Trash from "./features/Trash"
import Welcome from "./features/Welcome"
import AuthForm from "./features/AuthForm"
import { useExpiry } from "./hooks/useExpiry"
import {
  ApiError as ClientApiError,
  createDTO,
  decimal,
  draftDTO,
  newCommand,
} from "./api/client"

type ModalKind = "add" | "restore" | DetailAction | StatusMode | null
const statusModes: StatusMode[] = [
  "conflict",
  "timeout",
  "loading",
  "read",
  "notfound",
  "rate",
  "session",
  "insufficient",
]

function App({ demoMode = false }: { demoMode?: boolean } = {}) {
  const queryParams = useMemo(() => {
    if (typeof window === "undefined") return new URLSearchParams()
    return new URLSearchParams(window.location.search)
  }, [])

  const isDemo = demoMode || queryParams.has("demo")

  const [started, setStarted] = useState(
    () =>
      isDemo ||
      queryParams.has("started") ||
      localStorage.getItem("expiry_onboarding_done") === "1",
  )
  const markStarted = () => {
    localStorage.setItem("expiry_onboarding_done", "1")
    setStarted(true)
  }

  const [view, setView] = useState<View>(() => {
    const v = queryParams.get("view") as View
    return v && ["inventory", "attention", "trash", "settings"].includes(v)
      ? v
      : "attention"
  })
  const [filters, setFilters] = useState<InventoryFilters>(defaultFilters)
  const [selectedId, setSelectedId] = useState<string | null>(() =>
    queryParams.get("id"),
  )
  const [actionEntryId, setActionEntryId] = useState<string | null>(null)
  const [modal, setModal] = useState<ModalKind>(() => {
    const m = queryParams.get("modal") as ModalKind
    return m ? m : null
  })
  const [notice, setNotice] = useState("")
  const [pendingCreate, setPendingCreate] = useState<CreatePayload | null>(null)
  const [authModalOpen, setAuthModalOpen] = useState(false)
  const [revision, setRevision] = useState(0)

  // Real backend integration via useExpiry hook
  const real = useExpiry(view, filters, 1)

  // Demo fallback state (only when ?demo=1 or demoMode is explicitly active)
  const demoEntries = useMemo(() => (isDemo ? mockApi.listEntries() : []), [isDemo, revision])
  const demoTrash = useMemo(() => (isDemo ? mockApi.listTrash() : []), [isDemo, revision])
  const demoPrefs = useMemo(() => (isDemo ? mockApi.getPreferences() : null), [isDemo, revision])
  const demoSelected = useMemo(
    () => (isDemo && selectedId ? mockApi.getEntry(selectedId) : null),
    [isDemo, selectedId, revision],
  )

  // Active source of truth based on runtime mode
  const entries: FoodEntry[] = isDemo ? demoEntries : real.allFoods
  const trash: FoodEntry[] = isDemo ? demoTrash : real.trash
  const prefs = isDemo
    ? (demoPrefs ?? { timezone: "Asia/Ho_Chi_Minh", attention_lead_days: 2, version: 1 })
    : (real.prefs ?? {
        timezone: "Asia/Ho_Chi_Minh",
        attention_lead_days: 2,
        version: 1,
      })

  const selected: FoodEntry | null = isDemo
    ? demoSelected
    : (real.selected || entries.find((e) => e.id === selectedId) || null)

  const modalEntryId = actionEntryId ?? selectedId
  const modalEntry: FoodEntry | null = isDemo
    ? (modalEntryId ? mockApi.getEntry(modalEntryId) : null)
    : (entries.find((e) => e.id === modalEntryId) ||
       trash.find((e) => e.id === modalEntryId) ||
       selected ||
       null)

  const attention = (e: Pick<FoodEntry, "expiry_date">) =>
    attentionFor(e, prefs.attention_lead_days)

  const counts = useMemo(() => {
    const c: Record<Attention, number> = {
      past: 0,
      today: 0,
      soon: 0,
      unknown: 0,
      later: 0,
    }
    entries.forEach((e) => {
      if (e.remaining_quantity > 0) c[attention(e)] += 1
    })
    return c
  }, [entries, prefs])

  const urgentCount = counts.past + counts.today + counts.soon

  const visible = useMemo(
    () =>
      entries.filter((f) => {
        if (
          view === "attention" &&
          (attention(f) === "later" || f.remaining_quantity === 0)
        )
          return false
        if (
          filters.attentionFilter &&
          filters.attentionFilter !== "all" &&
          attention(f) !== filters.attentionFilter
        )
          return false
        if (
          filters.query &&
          !f.name.toLowerCase().includes(filters.query.toLowerCase())
        )
          return false
        if (
          filters.location !== "Tất cả vị trí" &&
          f.storage_location !== filters.location
        )
          return false
        if (
          view !== "attention" &&
          filters.lifecycle === "Còn hàng" &&
          f.remaining_quantity === 0
        )
          return false
        if (
          view !== "attention" &&
          filters.lifecycle === "Đã hết" &&
          f.remaining_quantity > 0
        )
          return false
        return true
      }),
    [entries, view, filters, prefs],
  )

  const displayName = isDemo
    ? (mockApi.user.display_name || "Bạn (Demo)")
    : (real.session?.user?.display_name || "Chưa đăng nhập")

  const navigate = (v: View) => {
    setView(v)
    setSelectedId(null)
    setActionEntryId(null)
    if (!isDemo) real.setSelectedId(null)
    if (v === "inventory" || v === "attention") setFilters(defaultFilters)
  }

  const closeModal = () => {
    setModal(null)
    setActionEntryId(null)
  }

  // Unified mutation handler supporting both real backend commands and demo in-memory
  const create = async (payload: CreatePayload) => {
    if (isDemo) {
      try {
        const id = mockApi.createEntry(
          mockApi.createCommandKey("create"),
          payload,
        ).data.id
        setRevision((r) => r + 1)
        setSelectedId(id)
        setModal(null)
        setNotice("Đã thêm thực phẩm vào kho")
        window.setTimeout(() => setNotice(""), 3000)
        return
      } catch (err) {
        setModal("read")
        return
      }
    }

    if (!real.session) {
      setPendingCreate(payload)
      setAuthModalOpen(true)
      return
    }

    const cmd = newCommand(
      real.session.user.id,
      "POST",
      "/food-entries",
      createDTO(payload),
    )
    const result = await real.run(cmd)
    if (result.ok) {
      setModal(null)
      setPendingCreate(null)
      setNotice("Đã thêm thực phẩm vào kho")
      window.setTimeout(() => setNotice(""), 3000)
    }
  }

  if (!started)
    return (
      <Welcome
        onStart={() => {
          markStarted()
          if (!isDemo && !real.session) {
            setAuthModalOpen(true)
          } else {
            setModal("add")
          }
        }}
        onSkip={() => {
          markStarted()
        }}
        onDemo={() => {
          markStarted()
          const url = new URL(window.location.href)
          url.searchParams.set("demo", "1")
          window.location.href = url.toString()
        }}
      />
    )

  return (
    <Shell
      view={view}
      setView={navigate}
      onAdd={() => {
        if (!isDemo && !real.session) {
          setAuthModalOpen(true)
        } else {
          setModal("add")
        }
      }}
      displayName={displayName}
      urgentCount={urgentCount}
      onAuth={!isDemo && !real.session ? () => setAuthModalOpen(true) : undefined}
    >
      {notice && (
        <div className="toast" role="status">
          <Icon name="check" />
          {notice}
        </div>
      )}

      {/* Global backend error display */}
      {!isDemo && real.error && !authModalOpen && (
        <div className="toast error" role="alert" style={{ background: "var(--danger, #dc2626)", color: "#fff" }}>
          <Icon name="alert" />
          {real.error.message}
          {real.canRetry && (
            <button
              type="button"
              style={{ marginLeft: 8, textDecoration: "underline", color: "#fff", background: "none", border: "none", cursor: "pointer" }}
              onClick={() => real.retry()}
            >
              Thử lại
            </button>
          )}
        </div>
      )}

      {selected && !selected.deleted_at ? (
        <Detail
          food={selected}
          attention={attention(selected)}
          movements={isDemo ? mockApi.listMovements(selected.id) : real.history}
          onBack={() => {
            setSelectedId(null)
            if (!isDemo) real.setSelectedId(null)
          }}
          parentLabel={
            view === "attention"
              ? "Cần chú ý"
              : view === "trash"
                ? "Thùng rác"
                : view === "settings"
                  ? "Cài đặt"
                  : "Kho thực phẩm"
          }
          onAction={setModal}
        />
      ) : view === "settings" ? (
        <Settings
          prefs={prefs}
          displayName={displayName}
          onSave={async (patch) => {
            if (isDemo) {
              mockApi.updatePreferences(
                mockApi.createCommandKey("preferences"),
                prefs.version,
                patch,
              )
              setRevision((r) => r + 1)
              setNotice("Đã lưu cài đặt")
              window.setTimeout(() => setNotice(""), 3000)
              return
            }

            if (!real.session) return
            const cmd = newCommand(real.session.user.id, "PATCH", "/me/preferences", {
              expected_version: prefs.version,
              ...patch,
            })
            const res = await real.run(cmd)
            if (res.ok) {
              setNotice("Đã lưu cài đặt")
              window.setTimeout(() => setNotice(""), 3000)
            }
          }}
          onLogout={
            !isDemo && real.session
              ? async () => {
                  await real.logout()
                  setNotice("Đã đăng xuất")
                  window.setTimeout(() => setNotice(""), 3000)
                }
              : undefined
          }
        />
      ) : view === "trash" ? (
        <Trash
          timezone={prefs.timezone}
          foods={trash}
          onRestore={(f) => {
            setSelectedId(f.id)
            if (!isDemo) real.setSelectedId(f.id)
            setModal("restore")
          }}
        />
      ) : (
        <Inventory
          mode={view === "attention" ? "attention" : "inventory"}
          foods={visible}
          allFoods={entries}
          counts={counts}
          leadDays={prefs.attention_lead_days}
          attention={attention}
          filters={filters}
          setFilters={setFilters}
          onOpen={(f) => {
            setSelectedId(f.id)
            if (!isDemo) real.setSelectedId(f.id)
          }}
          onAdd={() => {
            if (!isDemo && !real.session) {
              setAuthModalOpen(true)
            } else {
              setModal("add")
            }
          }}
          onShowAttention={() => navigate("attention")}
          onShowInventory={() => navigate("inventory")}
          onAction={(food, action) => {
            setActionEntryId(food.id)
            if (!isDemo) real.setSelectedId(food.id)
            setModal(action)
          }}
        />
      )}

      {/* Entry creation modal */}
      {modal === "add" && (
        <EntryForm
          initial={pendingCreate}
          onClose={() => setModal(null)}
          onCreate={create}
        />
      )}

      {/* Auth Modal for real API session */}
      {authModalOpen && (
        <AuthForm
          pending={real.busy}
          error={real.error?.message || ""}
          onClose={() => setAuthModalOpen(false)}
          onSubmit={async (mode, input) => {
            const res = await real.authenticate(mode, input)
            if (res.ok) {
              setAuthModalOpen(false)
              setNotice(mode === "login" ? "Đăng nhập thành công" : "Tạo tài khoản thành công")
              window.setTimeout(() => setNotice(""), 3000)
              if (pendingCreate) {
                const payload = pendingCreate
                setPendingCreate(null)
                await create(payload)
              }
            }
          }}
        />
      )}

      {/* Movement form (consume / discard / recount) */}
      {modalEntry &&
        (modal === "consume" || modal === "discard" || modal === "recount") && (
          <MovementForm
            food={modalEntry}
            mode={modal as MovementMode}
            onClose={closeModal}
            onSave={async (amount, why) => {
              if (isDemo) {
                const key = mockApi.createCommandKey(modal)
                try {
                  if (modal === "recount") {
                    mockApi.recount(key, modalEntry.id, modalEntry.version, amount, why)
                  } else {
                    mockApi.recordMovement(
                      key,
                      modalEntry.id,
                      modalEntry.version,
                      modal,
                      amount,
                      why || null,
                    )
                  }
                  setRevision((r) => r + 1)
                  closeModal()
                  setNotice(
                    modal === "recount"
                      ? "Đã cập nhật lượng sau kiểm lại"
                      : `Đã ghi nhận ${modal === "consume" ? "đã dùng" : "đã bỏ"}`,
                  )
                  window.setTimeout(() => setNotice(""), 3000)
                } catch {
                  setModal("conflict")
                }
                return
              }

              if (!real.session) return
              if (modal === "recount") {
                const cmd = newCommand(
                  real.session.user.id,
                  "POST",
                  `/food-entries/${modalEntry.id}/recounts`,
                  {
                    expected_version: modalEntry.version,
                    actual_quantity: decimal(amount),
                    reason: why || null,
                  },
                )
                const res = await real.run(cmd)
                if (res.ok) {
                  closeModal()
                  setNotice("Đã cập nhật lượng sau kiểm lại")
                  window.setTimeout(() => setNotice(""), 3000)
                }
              } else {
                const cmd = newCommand(
                  real.session.user.id,
                  "POST",
                  `/food-entries/${modalEntry.id}/movements`,
                  {
                    expected_version: modalEntry.version,
                    kind: modal,
                    amount: decimal(amount),
                    reason: why || null,
                  },
                )
                const res = await real.run(cmd)
                if (res.ok) {
                  closeModal()
                  setNotice(`Đã ghi nhận ${modal === "consume" ? "đã dùng" : "đã bỏ"}`)
                  window.setTimeout(() => setNotice(""), 3000)
                }
              }
            }}
          />
        )}

      {/* History log */}
      {selected && modal === "history" && (
        <History
          food={selected}
          movements={isDemo ? mockApi.listMovements(selected.id) : real.history}
          onClose={() => setModal(null)}
        />
      )}

      {/* Edit / Add Date modal */}
      {modalEntry && (modal === "edit" || modal === "date") && (
        <EntryForm
          entry={modalEntry}
          initialStep={modal === "date" ? 1 : 0}
          onClose={closeModal}
          onUpdate={async (patch) => {
            if (isDemo) {
              try {
                mockApi.updateEntry(
                  mockApi.createCommandKey("update"),
                  modalEntry.id,
                  modalEntry.version,
                  patch,
                )
                setRevision((r) => r + 1)
                closeModal()
                setNotice("Đã cập nhật thông tin")
                window.setTimeout(() => setNotice(""), 3000)
              } catch {
                setModal("conflict")
              }
              return
            }

            if (!real.session) return
            const cmd = newCommand(
              real.session.user.id,
              "PATCH",
              `/food-entries/${modalEntry.id}`,
              {
                expected_version: modalEntry.version,
                ...draftDTO(patch),
              },
            )
            const res = await real.run(cmd)
            if (res.ok) {
              closeModal()
              setNotice("Đã cập nhật thông tin")
              window.setTimeout(() => setNotice(""), 3000)
            }
          }}
        />
      )}

      {/* Soft Delete confirmation */}
      {selected && modal === "delete" && (
        <Dialog
          eyebrow="XÓA MÓN"
          title={`Xóa “${selected.name}”?`}
          body="Món sẽ được chuyển vào thùng rác và có thể khôi phục bất cứ lúc nào."
          action="Xóa vào thùng rác"
          actionVariant="danger"
          onClose={() => setModal(null)}
          onAction={async () => {
            if (isDemo) {
              try {
                mockApi.deleteEntry(
                  mockApi.createCommandKey("delete"),
                  selected.id,
                  selected.version,
                )
                setRevision((r) => r + 1)
                setModal(null)
                setSelectedId(null)
                setNotice("Đã chuyển vào thùng rác")
                window.setTimeout(() => setNotice(""), 3000)
              } catch {
                setModal("conflict")
              }
              return
            }

            if (!real.session) return
            const cmd = newCommand(
              real.session.user.id,
              "DELETE",
              `/food-entries/${selected.id}?expected_version=${selected.version}`,
            )
            const res = await real.run(cmd)
            if (res.ok) {
              setModal(null)
              setSelectedId(null)
              real.setSelectedId(null)
              setNotice("Đã chuyển vào thùng rác")
              window.setTimeout(() => setNotice(""), 3000)
            }
          }}
        />
      )}

      {/* Restore confirmation */}
      {modalEntry && modal === "restore" && (
        <Dialog
          eyebrow="KHÔI PHỤC"
          title={`Khôi phục “${modalEntry.name}”?`}
          body="Món sẽ trở lại kho thực phẩm với đầy đủ thông tin ban đầu."
          action="Khôi phục"
          onClose={() => {
            setModal(null)
            setSelectedId(null)
            if (!isDemo) real.setSelectedId(null)
          }}
          onAction={async () => {
            if (isDemo) {
              try {
                mockApi.restoreEntry(
                  mockApi.createCommandKey("restore"),
                  modalEntry.id,
                )
                setRevision((r) => r + 1)
                setModal(null)
                setSelectedId(null)
                navigate("inventory")
                setNotice("Đã khôi phục thực phẩm")
                window.setTimeout(() => setNotice(""), 3000)
              } catch {
                setModal("conflict")
              }
              return
            }

            if (!real.session) return
            const cmd = newCommand(
              real.session.user.id,
              "POST",
              `/food-entries/${modalEntry.id}/restore`,
              {
                expected_version: modalEntry.version,
              },
            )
            const res = await real.run(cmd)
            if (res.ok) {
              setModal(null)
              setSelectedId(null)
              real.setSelectedId(null)
              navigate("inventory")
              setNotice("Đã khôi phục thực phẩm")
              window.setTimeout(() => setNotice(""), 3000)
            }
          }}
        />
      )}

      {statusModes.includes(modal as StatusMode) && (
        <StatusDialog mode={modal as StatusMode} onClose={closeModal} />
      )}
    </Shell>
  )
}

export default App
</file>

<file path="apps/web/src/index.css">
@import "tailwindcss";

/* Collection ancestors only; the current food name remains the detail h1. */
.breadcrumb { min-width: 0; }
.breadcrumb ol { display: flex; align-items: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
.breadcrumb li { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
.breadcrumb button { display: inline-flex; align-items: center; gap: 4px; height: 32px; max-width: 192px; padding: 0; border: 0; background: transparent; color: var(--muted); font: inherit; cursor: pointer; }
.breadcrumb button:hover { color: var(--ink); }
.breadcrumb button:focus-visible { text-decoration: underline; }
.breadcrumb-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.breadcrumb-separator .icon, .breadcrumb-mobile-back .icon { width: 16px; height: 16px; flex-shrink: 0; }
.breadcrumb-mobile-back { display: none; }
@media (max-width: 639px) {
  .breadcrumb li:not(:last-child), .breadcrumb-separator { display: none; }
  .breadcrumb button { height: 40px; }
  .breadcrumb-mobile-back { display: inline-flex; }
}

/* Expiry UI — option A: grouped attention, flat surfaces, shared controls. */
:root {
  color-scheme: light;
  --app-font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, system-ui, sans-serif;
  --ink: #18212b;
  --ink-2: #2c3641;
  --foreground: var(--ink);
  --muted: #586572;
  --canvas: #f6f8fa;
  --surface: #fff;
  --fill: #eef1f4;
  --fill-2: #e4e9ee;
  --line: #d0d8e0;
  --line-2: #eef0f3;
  --danger: #b42318;
  --danger-bg: #fef0ee;
  --danger-sub: #fef0ee;
  --warn: #9a6700;
  --warn-bg: #fff7df;
  --warn-sub: #fff7df;
  --ok: #18794e;
  --ok-bg: #ebf8f1;
  --neutral: #586572;
  --neutral-bg: #eef1f4;
  /* Brand: existing blue roles, darkened one step for readable small text. */
  --accent: #075fad;
  --accent-hover: #0a6dd6;
  --accent-soft: #e8f2fd;
  --link: var(--accent);
  --ring-focus: rgb(10 109 214 / .12);
  --elevation-popover: 0 10px 15px -3px rgb(0 0 0 / .1), 0 4px 6px -4px rgb(0 0 0 / .1);
  --elevation-modal: 0 20px 25px -5px rgb(0 0 0 / .1), 0 8px 10px -6px rgb(0 0 0 / .1);
  --shadow-segment-track: inset 0 0 0 1px rgb(0 0 0 / .05), inset 0 1px 2px rgb(0 0 0 / .04);
  --shadow-segment-thumb: 0 0 0 1px rgb(0 0 0 / .04), 0 1px 2px rgb(0 0 0 / .06);
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 20px;
  --sp-6: 24px;
  --sp-8: 32px;
  --sp-10: 40px;
  --r-sm: 8px;
  --r-md: 12px;
  --r-lg: 16px;
  --r-xl: 16px;
  --r-card: 16px;
  --r-pill: 999px;
  /* Relative text scale also honors the browser's enlarged default font. */
  --t-xs: .75rem;
  --t-sm: .875rem;
  --t-base: 1rem;
  --t-md: 1.125rem;
  --t-lg: 1.25rem;
  --t-xl: 1.875rem;
  --control-h: 44px;
  --sidebar-w: 228px;
  --content-max: 1180px;
  --grid-cols: 4;
  --gutter: 18px;
  --margin: 16px;
  --dock-clearance: calc(6.5rem + env(safe-area-inset-bottom));
  font-family: var(--app-font);
  font-size: 100%;
  color: var(--ink);
  background: var(--canvas);
  font-synthesis: none;
  -webkit-font-smoothing: antialiased;
}

@theme {
  --font-sans: var(--app-font);

  /* Colors */
  --color-ink: var(--ink);
  --color-ink-2: var(--ink-2);
  --color-foreground: var(--foreground);
  --color-muted: var(--muted);
  --color-canvas: var(--canvas);
  --color-surface: var(--surface);
  --color-fill: var(--fill);
  --color-fill-2: var(--fill-2);
  --color-line: var(--line);
  --color-line-2: var(--line-2);

  /* Status & Alerts */
  --color-danger: var(--danger);
  --color-danger-bg: var(--danger-bg);
  --color-danger-sub: var(--danger-sub);
  --color-warn: var(--warn);
  --color-warn-bg: var(--warn-bg);
  --color-warn-sub: var(--warn-sub);
  --color-ok: var(--ok);
  --color-ok-bg: var(--ok-bg);
  --color-neutral: var(--neutral);
  --color-neutral-bg: var(--neutral-bg);

  /* Brand & Interactive */
  --color-accent: var(--accent);
  --color-accent-hover: var(--accent-hover);
  --color-accent-soft: var(--accent-soft);
  --color-link: var(--link);
  --color-ring-focus: var(--ring-focus);

  /* Typography Scale */
  --text-xs: var(--t-xs);
  --text-sm: var(--t-sm);
  --text-base: var(--t-base);
  --text-md: var(--t-md);
  --text-lg: var(--t-lg);
  --text-xl: var(--t-xl);

  /* Radius */
  --radius-sm: var(--r-sm);
  --radius-md: var(--r-md);
  --radius-lg: var(--r-lg);
  --radius-xl: var(--r-xl);
  --radius-card: var(--r-card);
  --radius-pill: var(--r-pill);

  /* Elevation / Shadows */
  --shadow-popover: var(--elevation-popover);
  --shadow-modal: var(--elevation-modal);
  --shadow-segment-track: var(--shadow-segment-track);
  --shadow-segment-thumb: var(--shadow-segment-thumb);

  /* Layout & Spacing */
  --spacing-sp-1: var(--sp-1);
  --spacing-sp-2: var(--sp-2);
  --spacing-sp-3: var(--sp-3);
  --spacing-sp-4: var(--sp-4);
  --spacing-sp-5: var(--sp-5);
  --spacing-sp-6: var(--sp-6);
  --spacing-sp-8: var(--sp-8);
  --spacing-sp-10: var(--sp-10);
  --spacing-gutter: var(--gutter);
  --spacing-margin: var(--margin);
  --spacing-control: var(--control-h);
  --spacing-sidebar: var(--sidebar-w);
  --spacing-content-max: var(--content-max);
}

@media (min-width: 768px) {
  :root {
    --grid-cols: 8;
    --control-h: 40px;
    --margin: 28px;
  }
}

@media (min-width: 1024px) {
  :root {
    --grid-cols: 12;
    --margin: clamp(22px, 4vw, 58px);
  }
}

@layer base {

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    min-width: 0;
  }

  body {
    background: var(--canvas);
    font-family: var(--app-font);
    font-size: var(--t-base);
    line-height: 1.5;
    margin: 0;
  }

  button {
    cursor: pointer;
    font: inherit;
  }

  button,
  a {
    outline: none;
  }

  h1,
  h2,
  h3,
  h4 {
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  input,
  textarea {
    width: 100%;
    min-width: 0;
    min-height: var(--control-h);
    padding: 9px 12px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font: inherit;
    transition: border-color .15s, box-shadow .15s;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--ring-focus);
  }

  input:disabled {
    background: var(--fill);
    color: var(--muted);
    cursor: not-allowed;
  }

  input[type="number"] {
    appearance: textfield;
  }

  input::-webkit-inner-spin-button,
  input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }
}

/* Stable 4px autohide scrollbar; JS adds is-scrolling to the scrolling element. */
* {
  --scrollbar-thumb: transparent;
}

*:hover {
  --scrollbar-thumb: color-mix(in srgb, var(--foreground) 16%, transparent);
}

.is-scrolling {
  --scrollbar-thumb: color-mix(in srgb, var(--foreground) 28%, transparent);
}

::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--foreground) 40%, transparent);
}

@supports not selector(::-webkit-scrollbar) {
  * {
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }

  *:hover {
    scrollbar-color: color-mix(in srgb, var(--foreground) 18%, transparent) transparent;
  }

  .is-scrolling {
    scrollbar-color: color-mix(in srgb, var(--foreground) 28%, transparent) transparent;
  }
}

.scrollbar-clean {
  scrollbar-width: none;
}

.scrollbar-clean::-webkit-scrollbar {
  display: none;
}

/* Shared grid, type, and controls. */
.layout-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
  column-gap: var(--gutter);
  row-gap: 18px;
  align-items: start;
}

.page {
  width: 100%;
  max-width: calc(var(--content-max) + var(--margin) * 2);
  margin: 0 auto;
  padding: 30px var(--margin) 48px;
}

.stack,
.rail,
.detail-aside,
.list-column {
  display: grid;
  gap: 16px;
  align-content: start;
  min-width: 0;
}

.eyebrow,
.section-label {
  display: block;
  color: var(--muted);
  font-size: var(--t-xs);
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.icon {
  width: 18px;
  height: 18px;
  flex: none;
  stroke-width: 1.8;
}

.button {
  outline: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: var(--control-h);
  max-width: 100%;
  padding: 8px 16px;
  border: 1px solid transparent;
  border-radius: var(--r-md);
  font-size: var(--t-sm);
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
  overflow-wrap: anywhere;
  cursor: pointer;
  user-select: none;
  position: relative;
  transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
}

.button:active:not(:disabled) {
  transform: translateY(1px);
}

.button.block {
  width: 100%;
}

/* Button Sizes */
.button.sm {
  min-height: 34px;
  padding: 6px 12px;
  font-size: var(--t-xs);
  gap: 6px;
}

.button.lg {
  min-height: 48px;
  padding: 12px 24px;
  font-size: var(--t-base);
  font-weight: 700;
  border-radius: var(--r-lg);
  gap: 10px;
}

/* Call To Action (CTA): Hero primary action */
.button.cta {
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  color: #fff;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4px 14px -2px rgba(7, 95, 173, 0.4), 0 2px 4px -2px rgba(7, 95, 173, 0.25);
}

.button.cta:hover:not(:disabled) {
  background: linear-gradient(135deg, var(--accent-hover), var(--accent));
  box-shadow: 0 6px 18px -2px rgba(7, 95, 173, 0.5), 0 3px 6px -2px rgba(7, 95, 173, 0.3);
  transform: translateY(-1px);
}

.button.cta:active:not(:disabled) {
  transform: translateY(1px);
  box-shadow: 0 2px 6px -1px rgba(7, 95, 173, 0.3);
}

/* Primary Button: Solid standard highlighted action */
.button.primary {
  background: var(--accent);
  color: #fff;
  border: 1px solid var(--accent);
  box-shadow: 0 2px 5px -1px rgba(7, 95, 173, 0.28);
}

.button.primary:hover:not(:disabled) {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  box-shadow: 0 4px 10px -1px rgba(7, 95, 173, 0.38);
  transform: translateY(-1px);
}

.button.primary:active:not(:disabled) {
  transform: translateY(1px);
  box-shadow: none;
}

/* Outline Button */
.button.outline {
  background: var(--surface);
  border-color: var(--line);
  color: var(--ink);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
}

.button.outline:hover:not(:disabled) {
  background: var(--fill);
  border-color: color-mix(in srgb, var(--line) 80%, black);
}

/* Secondary Button */
.button.secondary {
  background: var(--fill);
  border-color: transparent;
  color: var(--ink);
}

.button.secondary:hover:not(:disabled) {
  background: var(--fill-2);
}

/* Ghost Button */
.button.ghost {
  background: transparent;
  border-color: transparent;
  color: var(--muted);
}

.button.ghost:hover:not(:disabled) {
  background: rgb(24 33 43 / .06);
  color: var(--ink);
}

/* Danger Button: Destructive action */
.button.danger {
  background: var(--danger-bg);
  border-color: color-mix(in srgb, var(--danger) 30%, transparent);
  color: var(--danger);
  font-weight: 700;
}

.button.danger:hover:not(:disabled) {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
  box-shadow: 0 3px 10px -1px rgba(180, 35, 24, 0.35);
  transform: translateY(-1px);
}

.button.danger:active:not(:disabled) {
  transform: translateY(1px);
  box-shadow: none;
}

.button:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}

/* Focus indicator conforming to WCAG 2.2 */
.button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.button.danger:focus-visible {
  outline: 2px solid var(--danger);
  outline-offset: 2px;
}

/* Spinner indicator */
.button-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: button-spin .7s linear infinite;
  flex: none;
}

@keyframes button-spin {
  to {
    transform: rotate(360deg);
  }
}

.text-link,
.back-link {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--link);
  font-size: var(--t-sm);
  font-weight: 500;
}

.text-link:hover,
.back-link:hover {
  text-decoration: underline;
}

.icon-button {
  width: var(--control-h);
  height: var(--control-h);
  flex: none;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--muted);
  transition: background-color .15s, color .15s;
}

.icon-button:hover {
  background: var(--fill);
  color: var(--ink);
}

.card {
  padding: 24px;
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r-card);
}

.card.muted {
  background: var(--canvas);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.card-header h2 {
  font-size: var(--t-base);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  width: fit-content;
  max-width: 100%;
  padding: 4px 8px;
  border-radius: var(--r-pill);
  font-size: var(--t-xs);
  font-weight: 600;
  line-height: 1.4;
}

.badge .icon {
  width: 14px;
  height: 14px;
}

.badge.past {
  background: var(--danger-bg);
  color: var(--danger);
}

.badge.today,
.badge.soon {
  background: var(--warn-bg);
  color: var(--warn);
}

.badge.unknown,
.badge.later {
  background: var(--fill);
  color: var(--muted);
}

.past {
  color: var(--danger);
}

.today,
.soon {
  color: var(--warn);
}

.unknown,
.later {
  color: var(--muted);
}

.field {
  display: grid;
  gap: 7px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.field-label {
  padding: 0;
  font-size: var(--t-sm);
  font-weight: 600;
  color: var(--ink);
}

.field-hint,
.field-error {
  min-height: 17px;
  font-size: var(--t-xs);
  color: var(--muted);
  line-height: 1.4;
  text-wrap: pretty;
}

.field-error,
.required-marker {
  color: var(--danger);
}

.field.invalid input,
.field.invalid .select-trigger,
.field.invalid .date-picker-trigger {
  border-color: var(--danger);
}

.segmented {
  display: grid;
  grid-auto-columns: 1fr;
  grid-auto-flow: column;
  gap: 4px;
  padding: 4px;
  border-radius: var(--r-md);
  background: var(--canvas);
  box-shadow: var(--shadow-segment-track);
}

.segmented button {
  min-height: 36px;
  min-width: 0;
  padding: 6px 12px;
  border: 0;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--muted);
  font-size: var(--t-sm);
  transition: color .15s;
}

.segmented button:hover {
  color: var(--ink);
}

.segmented button.active {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
  box-shadow: var(--shadow-segment-thumb);
}

.chips,
.chip-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chips {
  margin-top: 8px;
}

.chips button {
  min-height: 32px;
  padding: 4px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--muted);
  font-size: var(--t-xs);
  transition: background-color .15s;
}

.chips button:hover {
  background: var(--fill);
}

.chips button.active {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

.chip-actions .button {
  min-height: 36px;
  padding: 6px 12px;
}

/* Custom selects and date popovers share input geometry and overlay tokens. */
.select-control,
.date-picker {
  min-width: 0;
}

.select-trigger,
.date-picker-trigger {
  width: 100%;
  min-width: 0;
  min-height: var(--control-h);
  padding: 9px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  font-size: var(--t-sm);
  transition: border-color .15s, box-shadow .15s;
}

.select-trigger:focus-visible,
.select-trigger[aria-expanded="true"],
.date-picker-trigger:focus-visible,
.date-picker-trigger[aria-expanded="true"] {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--ring-focus);
}

.select-trigger:disabled,
.date-picker-trigger:disabled {
  opacity: .6;
  cursor: not-allowed;
  background: var(--fill);
}

.select-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-chevron {
  display: inline-flex;
  margin-left: auto;
  color: var(--muted);
}

.select-chevron .icon {
  width: 16px;
  height: 16px;
  transition: transform .15s;
}

.select-trigger[aria-expanded="true"] .select-chevron .icon {
  transform: rotate(180deg);
}

.select-popover,
.date-picker-popover {
  z-index: 120;
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  box-shadow: var(--elevation-popover);
  animation: popover-in .15s ease-out;
}

.select-popover {
  padding: 4px;
}

.select-listbox {
  display: grid;
  gap: 4px;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-gutter: stable;
}

.select-listbox::-webkit-scrollbar-track {
  margin-block: 16px;
}

.select-option {
  width: 100%;
  min-height: 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 9px 12px;
  border: 0;
  border-radius: var(--r-md);
  text-align: left;
  background: var(--surface);
  font-size: var(--t-sm);
  line-height: 1.4;
  text-wrap: pretty;
}

.select-option > span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.select-option[data-highlighted],
.select-option:hover {
  background: var(--fill);
}

.select-option[aria-selected="true"] {
  font-weight: 600;
}

.select-option[aria-disabled="true"] {
  opacity: .5;
  cursor: not-allowed;
}

.select-option .icon {
  width: 16px;
  height: 16px;
}

.select-search {
  padding: 4px;
  border-bottom: 1px solid var(--line-2);
  margin-bottom: 4px;
}

.select-empty {
  padding: 16px;
  text-align: center;
  color: var(--muted);
}

.date-picker-trigger .placeholder {
  color: var(--muted);
}

.date-picker-trigger>.icon {
  color: var(--muted);
}

.date-picker-popover {
  width: 316px;
  padding: 12px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scroll-padding-block: 8px;
}

.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.date-picker-title {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 0 8px;
  border: 0;
  border-radius: var(--r-sm);
  background: transparent;
  font-weight: 600;
}

.date-picker-title:hover {
  background: var(--fill);
}

.date-picker-navigation {
  display: flex;
  gap: 4px;
}

.date-picker-navigation button {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--muted);
}

.date-picker-navigation button:hover {
  background: var(--fill);
  color: var(--ink);
}

.date-picker-body {
  position: relative;
}

.date-picker-weekdays,
.date-picker-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.date-picker-weekdays {
  height: 28px;
  align-items: center;
  text-align: center;
  color: var(--muted);
  font-size: var(--t-xs);
}

.date-picker-grid {
  gap: 4px 0;
}

.date-picker-day {
  position: relative;
  min-width: 0;
  height: 40px;
  border: 0;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--ink);
  font-size: var(--t-sm);
  font-variant-numeric: tabular-nums;
}

.date-picker-day:hover,
.date-picker-period:hover {
  background: var(--fill);
}

.date-picker-day:focus-visible:not(.selected),
.date-picker-period:focus-visible:not(.selected) {
  background: var(--fill-2);
  font-weight: 600;
}

.date-picker-day.outside-month {
  color: var(--muted);
}

.date-picker-day.selected {
  background: var(--accent);
  color: #fff;
}

.date-picker-day.today {
  font-weight: 700;
}

.date-picker-day.today::after {
  content: "";
  position: absolute;
  bottom: 4px;
  left: calc(50% - 2px);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
}

.date-picker-layer {
  position: absolute;
  inset: 0;
  display: grid;
  align-content: start;
  background: var(--surface);
}

.date-picker-month-grid,
.date-picker-year-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding-top: 28px;
}

.date-picker-period {
  min-height: 52px;
  min-width: 0;
  font-size: var(--t-sm);
  border: 0;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--ink);
}

.date-picker-period.selected {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.date-picker-period {
  position: relative;
}

.date-picker-today-dot {
  position: absolute;
  bottom: 4px;
  left: calc(50% - 2px);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
}

.date-picker-day.today::after {
  display: none;
}

.scrollbar-flash {
  --scrollbar-thumb: color-mix(in srgb, var(--foreground) 28%, transparent);
}

.date-picker-footer {
  margin: 12px -12px -8px;
  padding: 4px;
  border-top: 1px solid var(--line-2);
}

.date-picker-clear {
  width: 100%;
  min-height: 40px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: 0;
  border-radius: var(--r-md);
  background: transparent;
  text-align: left;
}

.date-picker-clear:hover {
  background: var(--fill);
}

.date-picker-clear:focus-visible,
.date-picker-title:focus-visible,
.date-picker-navigation button:focus-visible {
  background: var(--fill-2);
}

@keyframes popover-in {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
}

/* Shell. */
.app-shell {
  min-height: 100dvh;
}

.sidebar {
  display: none;
}

.shell-main {
  min-width: 0;
  padding-bottom: var(--dock-clearance);
}

.mobile-app-header {
  height: 60px;
  padding: 0 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: var(--surface);
  border-bottom: 1px solid var(--line-2);
}

.mobile-account {
  max-width: 130px;
  color: var(--muted);
  font-size: var(--t-xs);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  text-align: left;
}

.brand-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  flex: none;
  background: var(--accent);
  color: #fff;
  border-radius: var(--r-sm);
}

.brand-name {
  font-size: var(--t-md);
  font-weight: 700;
}

.sidebar-add {
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  color: #fff;
  font-size: var(--t-sm);
  font-weight: 700;
  box-shadow: 0 4px 14px -2px rgba(7, 95, 173, 0.4), 0 2px 4px -2px rgba(7, 95, 173, 0.25);
  cursor: pointer;
  transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar-add:hover {
  background: linear-gradient(135deg, var(--accent-hover), var(--accent));
  box-shadow: 0 6px 18px -2px rgba(7, 95, 173, 0.5), 0 3px 6px -2px rgba(7, 95, 173, 0.3);
  transform: translateY(-1px);
}

.sidebar-add:active {
  transform: translateY(1px);
  box-shadow: 0 2px 6px -1px rgba(7, 95, 173, 0.3);
}

.sidebar nav {
  display: grid;
  gap: 4px;
}

.sidebar nav button {
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border: 0;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--muted);
  text-align: left;
  font-weight: 400;
  transition: background-color .15s, color .15s;
}

.sidebar nav button:hover {
  background: var(--fill);
  color: var(--ink);
}

.sidebar nav button.active {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.sidebar nav button:focus-visible {
  background: var(--fill-2);
}

.brand:focus-visible {
  background: var(--fill);
  border-radius: var(--r-sm);
}

.sidebar-add:focus-visible,
.dock-hero-add-btn:focus-visible {
  background: var(--accent-hover);
}

.dock-tab:focus-visible {
  background: var(--fill);
}

.count {
  margin-left: auto;
  color: inherit;
  font-size: var(--t-xs);
  font-style: normal;
  font-variant-numeric: tabular-nums;
}

.sidebar-note {
  margin-top: auto;
  padding: 12px 8px;
  color: var(--muted);
  font-size: var(--t-xs);
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 8px 0;
  border-top: 1px solid var(--line-2);
  font-size: var(--t-xs);
}

.avatar {
  width: 32px;
  height: 32px;
  flex: none;
  border-radius: 50%;
  background: var(--fill);
  display: grid;
  place-items: center;
  color: var(--muted);
  font-weight: 600;
}

.bottom-dock-nav {
  position: fixed;
  z-index: 40;
  inset: auto 0 0;
  min-height: calc(68px + env(safe-area-inset-bottom));
  padding: 4px 0 max(4px, env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  background: var(--surface);
  border-top: 1px solid var(--line-2);
}

.dock-tab {
  min-height: 60px;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  font-size: var(--t-xs);
  font-weight: 400;
  transition: color .15s;
}

.dock-tab.active {
  color: var(--accent);
  font-weight: 600;
}

.dock-tab .icon {
  width: 20px;
  height: 20px;
}

.dock-icon-wrap {
  position: relative;
  display: inline-flex;
}

.dock-badge-dot {
  position: absolute;
  top: -2px;
  right: -3px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--danger);
}

.dock-center-action {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.dock-hero-add-btn {
  position: absolute;
  top: -16px;
  width: 48px;
  height: 48px;
  border: 3px solid var(--surface);
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  color: #fff;
  display: grid;
  place-items: center;
  box-shadow: 0 6px 16px rgba(7, 95, 173, 0.42), 0 2px 6px rgba(7, 95, 173, 0.25);
  cursor: pointer;
  transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
}

.dock-hero-add-btn:hover {
  background: linear-gradient(135deg, var(--accent-hover), var(--accent));
  transform: scale(1.06);
  box-shadow: 0 8px 20px rgba(7, 95, 173, 0.52);
}

.dock-hero-add-btn:active {
  transform: scale(0.94);
  box-shadow: 0 3px 8px rgba(7, 95, 173, 0.35);
}

.dock-hero-label {
  margin-top: 34px;
  font-size: var(--t-xs);
  font-weight: 700;
  color: var(--accent);
}

@media (min-width: 1024px) {
  .app-shell {
    padding-left: var(--sidebar-w);
  }

  .shell-main {
    padding-bottom: 0;
  }

  .mobile-app-header,
  .bottom-dock-nav {
    display: none;
  }

  .sidebar {
    position: fixed;
    z-index: 20;
    inset: 0 auto 0 0;
    width: var(--sidebar-w);
    padding: 22px 14px;
    background: var(--surface);
    border-right: 1px solid var(--line-2);
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
  }

  .sidebar .brand {
    padding: 0 8px 6px;
  }
}

/* Attention and inventory. */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
}

.page-header-copy {
  min-width: 0;
  display: grid;
  gap: 6px;
}

.page-header h1 {
  font-size: var(--t-xl);
  font-weight: 700;
}

.page-header p {
  max-width: 680px;
  color: var(--muted);
  font-size: var(--t-sm);
  line-height: 1.55;
}

.page-header-action {
  flex: none;
  padding-top: 4px;
}

.urgency-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.urgency-chip {
  min-height: 92px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  padding: 15px;
  border: 1px solid var(--line-2);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  transition: background-color .15s;
}

.urgency-chip>span {
  color: var(--muted);
  font-size: var(--t-xs);
}

.urgency-chip>span {
  text-wrap: balance;
}

.urgency-chip strong {
  font-size: 26px;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.urgency-chip.past strong {
  color: var(--danger);
}

.urgency-chip.today strong,
.urgency-chip.soon strong {
  color: var(--warn);
}

.urgency-chip:hover:not(:disabled),
.urgency-chip:focus-visible {
  background: var(--fill-2);
}

.urgency-chip.is-active {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.urgency-chip.zero {
  cursor: not-allowed;
}

.urgency-strip:has(.later) {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.urgency-strip>.text-link {
  grid-column: 1/-1;
  justify-self: end;
}

.active-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 14px;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: var(--t-sm);
}

.filters {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.search {
  flex: 1 1 240px;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: var(--control-h);
  padding: 0 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  color: var(--muted);
}

.search:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--ring-focus);
}

.search input {
  width: 100%;
  min-width: 0;
  min-height: calc(var(--control-h) - 2px);
  border: 0;
  background: transparent;
  padding: 0;
  box-shadow: none;
  font-size: var(--t-sm);
}

.search input:focus {
  box-shadow: none;
}

.clear-search {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  flex: none;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 20px;
  border-radius: var(--r-sm);
}

.clear-search:hover {
  background: var(--fill);
}

.filters .select-control {
  flex: 0 1 190px;
}

.inventory-workspace {
  display: grid;
  gap: 18px;
  align-items: start;
}

.inventory-workspace.with-guide {
  grid-template-columns: minmax(0, 1.6fr) minmax(240px, .7fr);
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: var(--t-xs);
}

.food-list {
  display: grid;
  gap: 10px;
}

.inventory-cards {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
}

.inventory-cards .food-row {
  grid-template-columns: 1fr;
}

.inventory-cards .food-row-actions {
  padding: 0 16px 16px 70px;
}

.attention-group {
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  background: var(--surface);
  overflow: hidden;
}

.attention-group h2 {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 52px;
  padding: 14px 16px 6px;
  font-size: var(--t-sm);
  font-weight: 600;
}

.attention-group h2 .icon {
  width: 16px;
  height: 16px;
}

.attention-group h2 em {
  margin-left: auto;
  font-size: var(--t-xs);
  font-weight: 400;
  font-style: normal;
  color: var(--muted);
  white-space: nowrap;
}

.attention-group-guide {
  padding: 0 16px 14px;
  color: var(--muted);
  font-size: var(--t-xs);
  line-height: 1.5;
}

.attention-group .food-list {
  gap: 0;
}

.food-row {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
}

.attention-group .food-row {
  border-width: 1px 0 0;
  border-radius: 0;
}

.food-row:hover {
  background: #fafbfc;
}

.food-card {
  min-width: 0;
  width: 100%;
  min-height: 106px;
  padding: 16px;
  border: 0;
  background: transparent;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
}

.food-card:hover {
  background: transparent;
}

.food-card:focus-visible {
  background: var(--fill);
}

.food-kind-icon {
  width: 42px;
  height: 42px;
  flex: none;
  display: grid;
  place-items: center;
  border-radius: var(--r-md);
  background: var(--fill);
  color: var(--muted);
}

.food-main {
  min-width: 0;
  flex: 1;
  display: grid;
  gap: 5px;
}

.food-meta > span {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* Large values move below the name at every width, not only on phones. */
.food-card.large-quantity {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) 16px;
}

.food-card.large-quantity .food-main {
  grid-column: 2;
}

.food-card.large-quantity .qty-col {
  grid-column: 2;
  flex-wrap: wrap;
}

.food-card.large-quantity > .icon {
  grid-column: 3;
  grid-row: 1;
}

.food-name {
  font-size: var(--t-base);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.food-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 8px;
  font-size: var(--t-xs);
  color: var(--muted);
}

.qty-col {
  display: flex;
  align-items: baseline;
  gap: 3px;
  flex: none;
}

.qty-num {
  font-size: var(--t-base);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.qty-unit {
  font-size: var(--t-xs);
  color: var(--muted);
}

.food-card>.icon {
  width: 16px;
  height: 16px;
  color: var(--muted);
}

.food-row-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 12px 16px 12px 0;
}

.row-action {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--ink);
  font-size: var(--t-xs);
  font-weight: 600;
  cursor: pointer;
  user-select: none;
  transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
}

.row-action:hover {
  background: var(--fill);
  border-color: color-mix(in srgb, var(--line) 75%, black);
}

.row-action:active {
  transform: translateY(1px);
}

.row-action.primary {
  background: var(--accent-soft);
  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  color: var(--accent);
  font-weight: 700;
}

.row-action.primary:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 2px 6px -1px rgba(7, 95, 173, 0.35);
}

.row-action.danger {
  background: var(--danger-bg);
  border-color: color-mix(in srgb, var(--danger) 35%, transparent);
  color: var(--danger);
  font-weight: 700;
}

.row-action.danger:hover {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
  box-shadow: 0 2px 6px -1px rgba(180, 35, 24, 0.35);
}

.row-action .icon {
  width: 16px;
  height: 16px;
}

.priority-guide {
  display: grid;
  gap: 14px;
  padding: 18px;
}

.priority-guide h2 {
  font-size: var(--t-base);
}

.priority-guide>p {
  color: var(--muted);
  font-size: var(--t-sm);
  line-height: 1.5;
}

.safety-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 12px;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: var(--t-xs);
  line-height: 1.5;
}

.safety-note .icon {
  width: 16px;
  height: 16px;
  margin-top: 2px;
}

.safety-note span {
  text-wrap: pretty;
}

.date-confidence {
  margin: 0;
}

.date-confidence>div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-top: 1px solid var(--line-2);
  font-size: var(--t-xs);
}

.date-confidence dt {
  color: var(--muted);
}

.date-confidence dd {
  margin: 0;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.priority-guide .demo-note {
  padding-top: 12px;
  border-top: 1px solid var(--line-2);
  font-size: var(--t-xs);
}

/* Detail uses the same card, facts, badges, and action geometry. */
.back-link {
  width: fit-content;
}

.detail-main {
  padding: 24px;
}

.detail-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 20px;
}

.detail-title h1 {
  margin-top: 8px;
  font-size: 1.75rem;
  overflow-wrap: anywhere;
}

.status-pill {
  display: inline-flex;
  padding: 3px 8px;
  border-radius: var(--r-pill);
  font-size: var(--t-xs);
  font-weight: 600;
}

.status-pill.is-active {
  background: var(--ok-bg);
  color: var(--ok);
}

.status-pill.is-empty {
  background: var(--fill);
  color: var(--muted);
}

.detail-top-actions {
  display: flex;
  gap: 8px;
  flex: none;
}

.action-pill-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  min-width: 40px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  font-size: var(--t-sm);
  transition: background-color .15s;
}

.action-pill-btn:hover {
  background: var(--fill);
}

.action-pill-btn.danger {
  color: var(--danger);
  background: var(--danger-bg);
  border-color: transparent;
}

.detail-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 20px;
}

.metric-box {
  min-width: 0;
  padding-top: 14px;
  border-top: 1px solid var(--line-2);
  display: grid;
  gap: 8px;
  align-content: start;
}

.metric-label {
  font-size: var(--t-xs);
  font-weight: 600;
  color: var(--muted);
}

.metric-label {
  text-wrap: balance;
}

.metric-val {
  display: flex;
  align-items: baseline;
  gap: 6px;
  min-height: 40px;
  flex-wrap: wrap;
  min-width: 0;
}

.metric-val strong {
  font-size: 2.25rem;
  line-height: 1.1;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  min-width: 0;
  overflow-wrap: anywhere;
}

.metric-val small {
  color: var(--muted);
  font-size: var(--t-base);
}

.metric-sub {
  color: var(--muted);
  font-size: var(--t-xs);
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.metric-sub strong {
  color: var(--ink);
  font-size: var(--t-sm);
  font-weight: 600;
}

.badge-estimate {
  color: var(--warn);
}

.next-step {
  display: grid;
  gap: 8px;
  margin-bottom: 20px;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--canvas);
}

.next-step h2 {
  font-size: var(--t-base);
}

.next-step p {
  color: var(--muted);
  font-size: var(--t-sm);
}

.next-step .button {
  justify-self: start;
}

.next-step .safety-note {
  margin-top: 4px;
  color: var(--ink);
}

.detail-actions-section {
  display: grid;
  gap: 10px;
  padding-top: 18px;
  border-top: 1px solid var(--line-2);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.facts {
  margin: 0;
}

.facts>div {
  display: grid;
  grid-template-columns: 38% minmax(0, 1fr);
  gap: 12px;
  padding: 11px 0;
  border-bottom: 1px solid var(--line-2);
  font-size: var(--t-sm);
}

.facts>div:last-child {
  border-bottom: 0;
}

.facts dt {
  color: var(--muted);
}

.facts dt {
  text-wrap: pretty;
}

.facts dd {
  margin: 0;
  font-weight: 500;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.history-row {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line-2);
  font-size: var(--t-xs);
}

.history-row:last-child {
  border-bottom: 0;
}

.history-row>span {
  color: var(--muted);
}

.history-row p {
  display: grid;
  gap: 4px;
}

.history-row small {
  color: var(--muted);
  font-size: var(--t-xs);
}

.history-row em {
  font-style: normal;
  font-variant-numeric: tabular-nums;
}

/* Secondary surfaces. */
.row-list {
  display: grid;
}

.trash-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line-2);
}

.trash-row:first-child {
  padding-top: 0;
}

.trash-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.trash-row>div {
  min-width: 0;
  display: grid;
  gap: 5px;
}

.trash-row strong {
  overflow-wrap: anywhere;
  font-size: var(--t-base);
}

.trash-row span {
  color: var(--muted);
  font-size: var(--t-xs);
}

.account-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.account-row>div {
  min-width: 0;
  display: grid;
  gap: 2px;
  overflow-wrap: anywhere;
}

.account-row small {
  color: var(--muted);
  font-size: var(--t-xs);
}

.settings-form {
  display: grid;
  gap: 20px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
}

.empty {
  min-height: 300px;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 10px;
  padding: 24px;
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  background: var(--surface);
  text-align: center;
}

.empty h2 {
  font-size: var(--t-lg);
}

.empty p {
  max-width: 420px;
  color: var(--muted);
  margin-bottom: 8px;
}

.toast {
  position: fixed;
  z-index: 90;
  top: 20px;
  right: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 18px;
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  background: var(--ink);
  color: #fff;
  font-size: var(--t-sm);
  box-shadow: var(--elevation-popover);
  animation: popover-in .15s ease-out;
}

/* One modal primitive for entry, movement, history, and recovery. */
.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgb(18 28 38 / .38);
  animation: backdrop-in .18s ease-out;
}

.modal {
  width: 100%;
  max-height: calc(100dvh - 32px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--elevation-modal);
  animation: modal-in .2s ease-out;
}

.modal.compact {
  max-width: 460px;
}

.modal.regular {
  max-width: 540px;
}

.modal.wide {
  max-width: 680px;
}

.modal-header {
  flex: none;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  padding: 20px 24px;
  border-bottom: 1px solid var(--line-2);
  max-height: 40dvh;
  overflow-y: auto;
}

.modal-header>div {
  min-width: 0;
  overflow-wrap: anywhere;
}

.modal-header h2 {
  margin-top: 5px;
  font-size: var(--t-lg);
  overflow-wrap: anywhere;
}

.modal-header p {
  margin-top: 6px;
  color: var(--muted);
  font-size: var(--t-sm);
}

.modal-footer {
  flex: none;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 16px 24px;
  border-top: 1px solid var(--line-2);
}

.footer-spacer {
  flex: 1;
}

.dialog-body {
  min-height: 0;
  overflow-y: auto;
  padding: 20px 24px;
  display: grid;
  gap: 16px;
  overscroll-behavior: contain;
  scroll-padding-block: 12px;
}

.dialog-body>p {
  color: var(--muted);
  line-height: 1.55;
}

.stepped-form {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stepper {
  flex: none;
  margin: 0;
  padding: 12px 24px;
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  border-bottom: 1px solid var(--line-2);
}

.stepper button {
  width: 100%;
  min-height: 40px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border: 0;
  border-bottom: 2px solid var(--fill);
  background: transparent;
  color: var(--muted);
  text-align: left;
  font-size: var(--t-sm);
}

.stepper button>span {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  flex: none;
  border: 1px solid var(--line);
  border-radius: 50%;
  font-size: var(--t-xs);
}

.stepper button.active {
  color: var(--ink);
  border-bottom-color: var(--accent);
  font-weight: 600;
}

.stepper button.active>span {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

.stepper button.done>span {
  background: var(--ok-bg);
  color: var(--ok);
  border-color: transparent;
}

.stepper button>span .icon {
  width: 14px;
  height: 14px;
}

.form-body {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  padding: 20px 24px;
  overscroll-behavior: contain;
  scroll-padding-block: 12px;
}

.modal.wide .form-body {
  max-height: min(460px, calc(100dvh - 280px));
}

.form-body.compact {
  display: grid;
  gap: 16px;
  align-content: start;
}

.form-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px 20px;
  align-content: start;
}

.span-2 {
  grid-column: 1/-1;
}

.row-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
}

.readonly-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 4px;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--fill);
}

.readonly-row small {
  grid-column: 1/-1;
  color: var(--muted);
  font-size: var(--t-xs);
}

.inline-hint,
.note-box {
  padding: 14px;
  border-radius: var(--r-md);
  background: var(--canvas);
  color: var(--muted);
  font-size: var(--t-sm);
  line-height: 1.5;
}

.note-box {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.amount-input {
  position: relative;
  display: flex;
  align-items: center;
}

.amount-input input {
  padding-right: 92px;
  min-height: 48px;
  font-size: var(--t-lg);
  font-variant-numeric: tabular-nums;
}

.amount-input>span {
  position: absolute;
  right: 12px;
  color: var(--muted);
}

.fill-all {
  position: absolute;
  right: 46px;
  min-height: 32px;
  padding: 4px 8px;
  border: 0;
  border-radius: var(--r-sm);
  background: var(--fill);
  color: var(--link);
  font-size: var(--t-xs);
}

.fill-all:hover {
  background: var(--fill-2);
}

.preview {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 18px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--fill);
  color: var(--muted);
}

.preview span {
  display: grid;
  gap: 4px;
  font-size: var(--t-xs);
}

.preview strong {
  color: var(--ink);
  font-size: var(--t-md);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

.timeline {
  min-height: 0;
  overflow-y: auto;
  padding: 0 24px 16px 28px;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  padding: 16px 0 16px 20px;
  border-left: 1px solid var(--line-2);
}

.timeline-dot {
  position: absolute;
  left: -5px;
  top: 22px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--muted);
}

.timeline-dot.discard {
  background: var(--danger);
}

.timeline-dot.recount {
  background: var(--warn);
}

.timeline-dot.initial {
  background: var(--ok);
}

.timeline-item span,
.timeline-item p {
  color: var(--muted);
  font-size: var(--t-xs);
}

.timeline-item h3 {
  margin: 4px 0;
  font-size: var(--t-sm);
}

.timeline-item>strong {
  text-align: right;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.timeline-item>strong small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
}

.compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.compare>span {
  display: grid;
  gap: 5px;
  padding: 16px;
  border-radius: var(--r-md);
  background: var(--fill);
}

.compare small {
  font-size: var(--t-xs);
  color: var(--muted);
}

.compare strong {
  font-size: var(--t-md);
}

.skeleton-stack {
  display: grid;
  gap: 8px;
}

.skeleton-stack i {
  height: 70px;
  display: block;
  background: var(--fill);
  border-radius: var(--r-md);
  animation: pulse 1.2s ease-in-out infinite alternate;
}

@keyframes pulse {
  to {
    opacity: .4;
  }
}

@keyframes backdrop-in {
  from {
    opacity: 0;
  }
}

@keyframes modal-in {
  from {
    opacity: 0;
    transform: translateY(8px) scale(.98);
  }
}

/* Existing onboarding, refined into the same brand and control system. */
.welcome {
  min-height: 100dvh;
  background: var(--surface);
  padding: 0 max(24px, calc((100vw - 1100px) / 2));
}

.welcome header {
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--line-2);
}

.wordmark {
  font-size: var(--t-md);
  font-weight: 700;
}

.skip-link {
  min-height: 40px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--link);
}

.skip-link:hover {
  text-decoration: underline;
}

.onboarding {
  min-height: calc(100dvh - 64px);
  padding: 10vh 0 40px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-rows: 1fr auto;
  gap: 32px;
}

.welcome-copy {
  align-self: center;
}

.welcome-copy h1 {
  margin: 16px 0 20px;
  max-width: 720px;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  line-height: 1.1;
  font-weight: 700;
}

.welcome-copy h1 em {
  color: var(--accent);
  font-style: normal;
}

.welcome-copy p {
  max-width: 580px;
  color: var(--muted);
  font-size: var(--t-md);
}

.onboarding-index {
  align-self: center;
  display: flex;
  align-items: baseline;
  gap: 8px;
  color: var(--muted);
}

.onboarding-index strong {
  color: var(--ink);
  font-size: 48px;
  font-weight: 600;
}

.onboarding-footer {
  grid-column: 1/-1;
  padding-top: 24px;
  border-top: 1px solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.onboarding-footer>div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.step-dots button {
  position: relative;
  width: 30px;
  height: 32px;
  padding: 0;
  border: 0;
  background: transparent;
}

.step-dots button::after {
  content: "";
  display: block;
  width: 30px;
  height: 6px;
  border-radius: var(--r-pill);
  background: var(--fill);
}

.step-dots button.active::after {
  background: var(--accent);
}

@media (max-width: 1279px) and (min-width: 1024px) {
  .inventory-workspace.with-guide {
    grid-template-columns: minmax(0, 1fr) 250px;
  }

  .food-row {
    grid-template-columns: 1fr;
  }

  .food-row-actions {
    padding: 0 16px 14px 70px;
  }
}

@media (max-width: 1023px) {
  .inventory-workspace.with-guide {
    grid-template-columns: minmax(0, 1fr);
  }

  .priority-guide {
    max-width: none;
  }
}

@media (max-width: 767px) {
  :root {
    --t-xl: 1.625rem;
  }

  input,
  textarea,
  .select-trigger,
  .date-picker-trigger,
  .search input {
    font-size: var(--t-base);
  }

  .page {
    padding-top: 20px;
    padding-bottom: 24px;
  }

  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .page-header-action {
    display: none;
  }

  .page-header p {
    font-size: var(--t-sm);
  }

  .urgency-strip,
  .urgency-strip:has(.later) {
    grid-template-columns: 1fr 1fr;
  }

  .urgency-chip {
    min-height: 92px;
    padding: 14px;
  }

  .urgency-chip.later {
    grid-column: 1/-1;
  }

  .filters .select-control {
    flex: 1 1 140px;
  }

  .search {
    flex-basis: 100%;
  }

  .food-row {
    grid-template-columns: 1fr;
  }

  .food-card {
    padding: 14px;
    min-height: 116px;
    gap: 10px;
  }

  .food-kind-icon {
    width: 36px;
    height: 36px;
  }

  .food-card>.icon {
    display: none;
  }

  .food-row-actions {
    padding: 0 14px 14px 60px;
  }

  .food-meta {
    display: grid;
    gap: 2px;
  }

  .qty-col {
    flex-direction: column;
    align-items: flex-end;
  }

  .qty-num {
    font-size: var(--t-base);
  }

  .row-action {
    min-height: 40px;
  }

  .active-filter-bar {
    align-items: flex-start;
  }

  .card {
    padding: 18px;
  }

  .detail-title {
    gap: 12px;
  }

  .detail-title {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .detail-title>div:first-child {
    display: contents;
  }

  .detail-title .status-pill {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .detail-title h1 {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 0;
  }

  .detail-title h1 {
    font-size: 1.5rem;
  }

  .detail-top-actions {
    grid-column: 2;
    grid-row: 1;
    flex-direction: row;
  }

  .detail-hero-grid {
    gap: 12px;
  }

  .metric-val strong {
    font-size: 1.875rem;
  }

  .metric-val .badge {
    font-size: var(--t-xs);
  }

  .detail-hero-grid {
    grid-template-columns: 1fr;
  }

  .food-card.large-quantity {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 16px;
  }

  .food-card.large-quantity .food-main {
    grid-column: 2;
  }

  .food-card.large-quantity .qty-col {
    grid-column: 2;
    flex-direction: row;
    align-items: baseline;
  }

  .action-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.5rem), 1fr));
  }

  .action-row> :first-child {
    grid-column: 1/-1;
  }

  .facts>div {
    grid-template-columns: 38% minmax(0, 1fr);
  }

  .modal-backdrop {
    padding: 0;
    place-items: end center;
  }

  .modal {
    max-height: 94dvh;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }

  .modal.layout-form.wide {
    height: 100dvh;
    max-height: 100dvh;
    border-radius: 0;
  }

  .modal-header,
  .modal-footer,
  .dialog-body,
  .form-body {
    padding-left: 16px;
    padding-right: 16px;
  }

  .modal-header {
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .modal-footer {
    padding-bottom: max(16px, env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .modal-footer .footer-spacer {
    display: none;
  }

  .modal-footer > .button:only-of-type,
  .modal-footer > .button:nth-of-type(3):last-child {
    grid-column: 1 / -1;
  }

  .modal.wide .form-body {
    max-height: none;
  }

  .stepper {
    padding: 8px 16px;
    gap: 8px;
  }

  .stepper button {
    font-size: var(--t-xs);
    padding: 6px 0;
    gap: 6px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .location-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .location-chips>button:last-child {
    grid-column: 1 / -1;
  }

  .reason-choices {
    display: grid;
    grid-template-columns: 1fr;
  }

  .reason-choices>button:last-child {
    grid-column: 1 / -1;
  }

  .reason-choices>button {
    text-wrap: balance;
  }

  .inventory-cards {
    grid-template-columns: 1fr;
  }

  .inventory-cards .food-row-actions {
    padding-left: 60px;
  }

  .span-2 {
    grid-column: auto;
  }

  .row-3 {
    grid-template-columns: 1fr 1fr;
  }

  .row-3> :first-child {
    grid-column: 1/-1;
  }

  .timeline {
    padding-inline: 20px;
  }

  .timeline-item {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .timeline-item>strong {
    text-align: left;
  }

  .toast {
    top: 12px;
    left: 12px;
    right: 12px;
    justify-content: center;
  }

  .trash-row {
    align-items: flex-start;
  }

  .welcome {
    padding: 0 16px;
  }

  .onboarding {
    padding: 40px 0 24px;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr auto auto;
    gap: 24px;
  }

  .onboarding-index {
    grid-row: 2;
  }

  .onboarding-index strong {
    font-size: 2.25rem;
  }

  .onboarding-footer {
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .onboarding-footer>div:last-child {
    justify-content: flex-end;
  }

  .welcome-copy h1 {
    font-size: clamp(2.5rem, 12vw, 3.5rem);
  }
}

@media (max-width: 380px) {
  .modal-footer .button {
    padding-inline: 10px;
  }

  .food-row-actions {
    padding-left: 14px;
  }

  .inventory-cards .food-row-actions {
    padding-left: 14px;
  }

  .date-picker-popover {
    padding: 8px;
  }

  .date-picker-footer {
    margin-inline: -8px;
  }
}

/* Keyboard focus is an interaction state, not decoration. Shared by all controls. */
:is(button, a, input, textarea, summary, [tabindex]):focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

:is(button, a, input, textarea, summary, [tabindex]) {
  scroll-margin-block: 12px;
}

