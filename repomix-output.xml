import assert from 'node:assert/strict';
import fs from 'node:fs';
import { createRequire } from 'node:module';
const require = createRequire('/home/pro/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/package.json');
const { chromium } = require('playwright');
const browser = await chromium.launch({ headless: true });
const checks = [];
try {
  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
  const errors = [];
  page.on('pageerror', error => errors.push(String(error)));
  await page.goto('http://127.0.0.1:4174/?demo&view=inventory');
  const crumbs = page.getByRole('navigation', { name: 'Đường dẫn', exact: true });
  assert.equal(await crumbs.count(), 0);
  await page.getByRole('textbox', { name: 'Tìm theo tên' }).fill('Sữa');
  await page.getByRole('button', { name: /^Xem Sữa tươi không đường/ }).first().click();
  assert.equal(await crumbs.count(), 1);
  const parent = crumbs.getByRole('button', { name: 'Kho thực phẩm', exact: true });
  await parent.focus();
  await page.keyboard.press('Tab');
  await page.keyboard.press('Shift+Tab');
  assert.equal(await parent.evaluate(el => getComputedStyle(el).textDecorationLine), 'underline');
  await page.keyboard.press('Enter');
  assert.equal(await page.getByRole('textbox', { name: 'Tìm theo tên' }).inputValue(), 'Sữa');
  assert.equal(await crumbs.count(), 0);
  checks.push('Inventory parent + keyboard return preserves search filter; top-level breadcrumb absent');
  await page.goto('http://127.0.0.1:4174/?demo&view=attention&id=ent_1');
  assert.equal(await crumbs.getByRole('button', { name: 'Cần chú ý', exact: true }).count(), 1);
  for (const width of [375, 639, 640, 768, 1024, 1280, 1440]) {
    await page.setViewportSize({ width, height: 900 });
    const measurement = await page.evaluate(() => {
      const button = document.querySelector('.breadcrumb button');
      return { width: innerWidth, scroll: document.documentElement.scrollWidth,
               h1: document.querySelectorAll('h1').length, height: button.getBoundingClientRect().height };
    });
    assert.equal(measurement.scroll, width);
    assert.equal(measurement.h1, 1);
    assert.equal(measurement.height, width < 640 ? 40 : 32);
    if (width === 375 || width === 1280) {
      await page.screenshot({ path: `.tmb/evidence/breadcrumb-${width}.png`, fullPage: true });
    }
    checks.push(measurement);
  }
  assert.deepEqual(errors, []);
  checks.push('No pageerror during focused inventory/attention detail smoke');
  fs.writeFileSync('.tmb/evidence/breadcrumb-check.json', JSON.stringify({ status: 'PASS', checks,
    limits: 'Local Chromium demo only; no live API/DB, real device/Safari or user study.' }, null, 2) + '\n');
  console.log(JSON.stringify({ status: 'PASS', checks }));
} finally { await browser.close(); }
