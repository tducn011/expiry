{
  "$schema": "https://raw.githubusercontent.com/yamadashy/repomix/main/repomix.config.schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false
  },
  "ignore": {
    "useGitignore": false,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.pnpm-store/**",
      "**/dist/**",
      "**/build/**",
      "**/.cache/**",
      "**/.vite/**",
      "**/.vercel/**",
      "**/*.tsbuildinfo",
      "**/.vscode/**",
      "**/.idea/**",
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/*.swp",
      "**/*.swo",
      "**/*.bak",
      "**/.unlazy/**",
      "**/__pycache__/**",
      "**/*.py[cod]",
      "**/.pytest_cache/**",
      "**/.venv/**",
      "**/venv/**",
      "**/.env",
      "**/.env.local",
      "**/.env.*.local",
      "**/.env.development",
      "**/.env.production",
      "**/.env.test",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lockb",
      "**/*.log",
      "**/logs/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.ico",
      "**/*.webp",
      "**/*.pdf",
      "**/*.sqlite",
      "**/*.sqlite3",
      "**/*.db",
      "**/*.mwb",
      "database/mysql/.tools/**"
    ]
  }
}
