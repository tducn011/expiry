{
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/health/(.*)",
      "destination": "https://con-launches-scsi-baskets.trycloudflare.com/health/$1"
    },
    {
      "source": "/health",
      "destination": "https://con-launches-scsi-baskets.trycloudflare.com/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://con-launches-scsi-baskets.trycloudflare.com/api/$1"
    },
    {
      "source": "/scan/(.*)",
      "destination": "https://con-launches-scsi-baskets.trycloudflare.com/scan/$1"
    },
    {
      "source": "/scan",
      "destination": "https://con-launches-scsi-baskets.trycloudflare.com/scan"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
