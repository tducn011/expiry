{
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://asthma-casa-saturn-collaboration.trycloudflare.com/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://asthma-casa-saturn-collaboration.trycloudflare.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
